# ── Database (MariaDB / MySQL) ───────────────────────────────────────────
# Production host (e.g. Hostinger hPanel → Databases): mysql://USER:PASSWORD@HOST:3306/DBNAME
DATABASE_URL=mysql://user:password@localhost:3306/footgrit_finance
# Keep small on shared hosting — it caps connections per DB user.
# DATABASE_POOL_SIZE=5

# ── Auth.js ──────────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Public URL of this site, e.g. https://finance.example.com
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ── Owner account (only read by `npm run db:seed:owner`) ─────────────────
OWNER_EMAIL=
OWNER_PASSWORD=

# ── Optional: password for the demo Admin Unit logins (`npm run db:seed:demo`) ──
# DEMO_PASSWORD=
